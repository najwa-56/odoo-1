		 <record id="inventory_custom_product_form" model="ir.ui.view">
				<field name="name">inventory.custom.product.form</field>
				<field name="model">inventory.custom.product</field>
				<field name="arch" type="xml">
					<form string="Directory">
						<sheet>
							<group>
								<field name="name"/>
								<field name="check_active"/>
							</group>
							<notebook>
								<page string="Template">
									<field name="inventory_custom_line_ids">
										<tree editable="bottom">
											<field name ="product_id"/>
											<field name ="uom"/>
											
										</tree>
									</field>
								</page>
							</notebook>
							
						</sheet>
					</form>
					</field>
				</record>

		<record id="inventory_custom_product_tree" model="ir.ui.view">
            <field name="name">inventory.custom.product.tree</field>
            <field name="model">inventory.custom.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>        
                    <field name="check_active"/>            
                </tree>
            </field>
        </record>

	 	<record id="inventory_custom_action_view_tree" model="ir.actions.act_window">
	 		<field name="name">inventory.custom.view</field>
			<field name="res_model">inventory.custom.product</field>
            <field name="view_mode">tree</field>
            <field name="view_id" eval="inventory_custom_product_tree"/>

        </record>


		<record id="open_inventory_custom_my_list" model="ir.actions.act_window">
				<field name="name">Product Template</field>
				<field name="res_model">inventory.custom.product</field>
				<field name="view_mode">tree,form</field>
				<field name="help" type="html">
					<p class="oe_view_nocontent_create">
							Click to create Product Template.
						</p>
				</field>
		 </record>

		<menuitem
				id="custom_product_template"
				name="Custom Product Template"
				action="open_inventory_custom_my_list"
				/>

	</data>
</odoo>