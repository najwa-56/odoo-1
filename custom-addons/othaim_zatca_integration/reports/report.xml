<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    

    <record id="paperformat_low_simplified" model="report.paperformat">
        <field name="name">Othaim A4 low margin</field>
        <field name="default" eval="True"/>
         <field name="format">custom</field>
         <field name="page_height">307</field>
         <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">200</field>
    </record>

    

   


    <record id="action_report_tax_invoice" model="ir.actions.report">
        <field name="name">Saudi VAT Invoice Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">othaim_zatca_integration.report_tax_invoice</field>
        <field name="report_file">othaim_zatca_integration.report_tax_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tax_invoice2" model="ir.actions.report">
        <field name="name">Saudi VAT Invoice purchase Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">othaim_zatca_integration.report_tax_invoice2</field>
        <field name="report_file">othaim_zatca_integration.report_tax_invoice2</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>



    <record id="action_report_simplified_tax_invoice" model="ir.actions.report">
        <field name="name">Simplified VAT Invoice Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">othaim_zatca_integration.report_simplified_tax_invoice</field>
        <field name="report_file">othaim_zatca_integration.report_simplified_tax_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>




  

    <record id="action_report_standard_low_margin_tax_invoice" model="ir.actions.report">
        <field name="name">Recipt VAT Invoice Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">othaim_zatca_integration.report_tax_low_margin_invoice</field>
        <field name="report_file">othaim_zatca_integration.report_tax_low_margin_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="othaim_zatca_integration.paperformat_low_simplified"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>