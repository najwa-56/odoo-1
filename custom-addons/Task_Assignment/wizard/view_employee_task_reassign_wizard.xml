<?xml version="1.0" encoding="utf-8"?>

<odoo>

<record id="view_task_name_reassign_wizard" model="ir.ui.view">
    <field name="name">task.name.reassign.wizard</field>
    <field name="model">task.name.reassign.wizard</field>
    <field name="arch" type="xml">
        <form string="Update Default Next Employee">
            <group>
                <field name="employee_id"/>
            </group>
            <footer>
                <button name="action_mass_update_next_employee"
                        type="object"
                        string="Apply" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_task_name_reassign_wizard" model="ir.actions.act_window">
    <field name="name">Update Default Employee</field>
    <field name="res_model">task.name.reassign.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>


</odoo>
