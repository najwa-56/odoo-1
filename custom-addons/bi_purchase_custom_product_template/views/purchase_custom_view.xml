<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>
		<!-- Inherit Purchase Order View to add a new field -->
		<record id="view_inherit_purchase_order" model="ir.ui.view">
            <field name="name">view.inherit.purchase.order</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//form/sheet/group/group/field[@name='date_order']" position="after">
            		<field name="product_template_id"/>
			   </xpath>
        	</field>
		</record>

		<!-- Inherit Purchase Order Line Tree View to add a custom field -->
		<record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
			<xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="before">
            		<field name="custom"/>
			   </xpath>
        	</field>
		</record>

		<!-- Form view for purchase.custom.product -->
		<record id="purchase_custom_product_form" model="ir.ui.view">
				<field name="name">purchase.custom.product.form</field>
				<field name="model">purchase.custom.product</field>
				<field name="arch" type="xml">
					<form string="Directory">
						<sheet>
							<group>
								<field name="name"/>
								<field name="check_active"/>
							</group>
							<notebook>
								<page string="Template">
									<field name="purchase_custom_line_ids">
										<tree editable="bottom">
											<field name="product_id"/>
											<field name="desc_name"/>
											<field name="order_qty"/>
											<field name="unit_price"/>
											<field name="uom"/>
										</tree>
									</field>
								</page>
							</notebook>
						</sheet>
					</form>
				</field>
		</record>

		<!-- Tree view for purchase.custom.product -->
		<record id="purchase_custom_product_tree" model="ir.ui.view">
            <field name="name">purchase.custom.product.tree</field>
            <field name="model">purchase.custom.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="check_active"/>
                </tree>
            </field>
        </record>

		<!-- Action Window for purchase.custom.product -->
	 	<record id="purchase_custom_action_view_tree" model="ir.actions.act_window">
	 		<field name="name">Purchase Custom View</field>
			<field name="res_model">purchase.custom.product</field>
            <field name="view_mode">tree,form</field>
        </record>

		<!-- Menu Item for purchase.custom.product -->
		<menuitem
				id="custom_product_template"
				name="Custom Product Template"
				parent="purchase.menu_procurement_management"
				action="purchase_custom_action_view_tree"
				sequence="10"
			/>

		<!-- Tree view for inventory.custom.product -->
		<record id="inventory_custom_product_tree" model="ir.ui.view">
            <field name="name">inventory.custom.product.tree</field>
            <field name="model">inventory.custom.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="check_active"/>
                </tree>
            </field>
        </record>

		<!-- Action Window for inventory.custom.product -->
	 	<record id="inventory_custom_action_view_tree" model="ir.actions.act_window">
	 		<field name="name">Inventory Custom View</field>
			<field name="res_model">inventory.custom.product</field>
            <field name="view_mode">tree,form</field>
        </record>

		<!-- Menu Item for inventory.custom.product -->
		<menuitem
				id="custom_product_templatee"
				name="Inventory Product Template"
				parent="stock.menu_stock_root"
				action="inventory_custom_action_view_tree"
				sequence="10"
			/>

	</data>
</odoo>
