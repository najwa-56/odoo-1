<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_expense_user_rule" model="ir.rule">
        <field name="name">Expense Expense User Rule</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('product_id.user_ids', '=', False), ('product_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

     <record id="product_product_user_rule" model="ir.rule">
        <field name="name">Expense Product User Rule</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
