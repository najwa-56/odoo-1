<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_schedule_by_tag_wizard_form" model="ir.ui.view">
        <field name="name">hr.employee.schedule.by.tag.wizard.form</field>
        <field name="model">hr.employee.schedule.by.tag.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Working Schedule" create="false" edit="false">
                <group>
                    <group>
                    <field name="category_ids" widget="many2many_tags"
                           placeholder="Choose Tags..."/>
                    <field name="employee_ids" 
                          
                           widget="many2many_tags" />
                    <field name="schedule_id" options="{'no_create': True,'no_open': True}"/>
                </group>
            </group>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_schedule_by_tag" model="ir.actions.act_window">
        <field name="name">Mass-Update Working Schedule</field>
        <field name="res_model">hr.employee.schedule.by.tag.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    
    <menuitem id="menu_employee_schedule_by_tag"
              name="Mass-Update Working Schedule"
              parent="hr.menu_hr_employee_payroll"
              action="action_employee_schedule_by_tag"
              sequence="220"
              groups="hr.group_hr_user"/>
</odoo>
