<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Scheduled action for Employee data expiration -->
        <record id="ir_con_employee_data_reminder" model="ir.cron">
            <field name="name">HR Employee Data Expiration</field>
            <field name="interval_number">12</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.expiry_mail_reminder()</field>
        </record>


        <record id="cron_contract_expir_reminder" model="ir.cron" forcecreate="True">
		<field name="name">Contract Expiration Remainder </field>
		<field name="user_id" ref="base.user_root" />
		<field name="interval_number">4</field>
		<field name="interval_type">hours</field>
		<field name="numbercall">-1</field>
		<field name="model_id" ref="model_hr_contract" />
		<field name="state">code</field>
		<field name="code">model._get_expire_contract()</field>
	</record>


    </data>
</odoo>
