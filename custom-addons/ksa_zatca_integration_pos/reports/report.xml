<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pos_paperformat_standard" model="report.paperformat">
        <field name="name">B2B Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>


    <record id="report_e_invoicing_b2c_invoice" model="ir.actions.report">
        <field name="name">E Invoice Simplified Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ksa_zatca_integration_pos.report_e_invoicing_b2c_invoice_template</field>
        <field name="report_file">ksa_zatca_integration_pos.report_e_invoicing_b2c_invoice_template</field>
        <field name="print_report_name">object.zatca_invoice_name.replace('.xml', '')</field>
        <field name="paperformat_id" ref="ksa_zatca_integration_pos.paperformat_standard"/>
    </record>


</odoo>