<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<record id="ir_cron_pos_order_create_invoice" model="ir.cron">
    <field name="name">Create Invoice From Pos Order</field>
    <field name="model_id" ref="model_pos_order" />
    <field name="state">code</field>
    <field name="code">model.create_pos_order_invoice()</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
</record>





    <record id="ir_cron_pos_order_with_job_count" model="ir.cron">
    <field name="name">Batch Invoice From POS Order</field>
    <field name="model_id" ref="model_pos_order" />
    <field name="state">code</field>
    <field name="code">model.create_pos_order_invoice_batch(batch_size=500)</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
</record>

 





 <record id="ir_cron_update_inv_date_job_count" model="ir.cron">
    <field name="name">Update Invoice Order Date To Zatca</field>
    <field name="model_id" ref="model_pos_order" />
    <field name="state">code</field>
    <field name="code">model.update_date_invoice_batch(batch_size=500)</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
</record>



</data>
</odoo>