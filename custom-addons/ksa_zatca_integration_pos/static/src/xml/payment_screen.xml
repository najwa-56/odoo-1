<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ksa.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        
        <xpath expr="//button[contains(@class, 'js_invoice')]" position="attributes">
            <attribute name="t-attf-class">d-none</attribute>
        </xpath>
        
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <button class="button js_invoice btn btn-light py-3 text-start rounded-0 border-bottom"
                t-att-class="{ 'highlight text-bg-primary': currentOrder.is_invoice_b2b }"
                t-on-click="toggleIsInvoiceB2b">
            <i class="fa fa-check-square-o me-2" />Print Standard Invoice
        </button>

        <button class="button js_invoice btn btn-light py-3 text-start rounded-0 border-bottom"
        t-att-class="{ 'highlight text-bg-primary': currentOrder.is_invoice_b2c }"
        t-on-click="toggleIsInvoiceB2c">
    <i class="fa fa-check-square-o me-2" />Print Simplified Invoice
</button>


<button class="button js_invoice btn btn-light py-3 text-start rounded-0 border-bottom"
t-att-class="{ 'highlight text-bg-primary': currentOrder.is_no_invoice }"
t-on-click="toggleNoInvoice">
<i class="fa fa-check-square-o me-2" />No Invoice
</button>

        


        </xpath>
    </t>

</templates>
