<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">purchase.order.form.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="fixed_discount" optional="show"/>
                <field name="amount_before_discount" optional="show"/>
            </xpath>

             
                <xpath expr="//tree/field[@name='discount']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                  <xpath expr="//tree/field[@name='name']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

             <field name="tax_totals" position="before">
                     <field name="total_lines_discount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </field>

        </field>
    </record>
</odoo>
