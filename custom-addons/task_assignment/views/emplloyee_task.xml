<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_view_child_tasks" model="ir.actions.act_window">
    <field name="name">Child Tasks</field>
    <field name="res_model">employee.task</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('parent_task_id', '=', active_id)]</field>
    <field name="context">{}</field>
        </record>
    <record id="view_employee_task_form" model="ir.ui.view">
        <field name="name">employee.task.form</field>
        <field name="model">employee.task</field>
        <field name="arch" type="xml">
            <form string="Employee Task">

                <header>
            <button name="action_assign" type="object" string="Assign Task"
                     class="btn-primary" invisible="status != 'draft'"/>

            <button name="action_done" type="object" string="Mark as Completed"
                    class="btn-success" invisible="status != 'assigned'"/>

            <button name="action_cancel" type="object" string="Cancel Task"
                    class="btn-danger" invisible="status != 'assigned'"/>
            <field name="status" widget="statusbar" statusbar_visible="draft,assigned,done,cancel"/>

                </header>

                <sheet>
                     <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <!-- to make reference field in the header -->
                            <h1>
                                <field name="task_code" readonly="1"/>
                            </h1>
                    </div>
                     <div class="oe_button_box" name="button_box">

                         <button name="%(action_view_child_tasks)d"
                                type="action"
                               class="oe_stat_button"
                               icon="fa-sitemap"
                               invisible="child_task_ids == False">
                         <field name="child_task_ids" widget="statinfo" string="Next Tasks"/>
                         </button>
                     </div>


                    <group colspan="2">
        <group>
            <!-- LEFT SIDE GROUP -->
            <field name="status_display"
                   readonly="1" widget="badge"
                   options="{'draft': 'info', 'done': 'success', 'cancel': 'danger'}"/>
            <field name="task_code" readonly="1"/>
            <field name="priority" />
            <field name="task_id"/>
             <field name="image_desc" widget="image" class="oe_avatar"/>
              <field name="description" readonly="1" groups="task_assignment.group_task_user"/>
              <field name="description" groups="task_assignment.group_task_manager,task_assignment.group_task_supervisor"/>
             <field name="employee_id" readonly="1" groups="task_assignment.group_task_user"/>
            <field name="employee_id" groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            <field name="supervisor_id" readonly="1" groups="task_assignment.group_task_user"/>
            <field name="supervisor_id" groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            </group>
                         <group>
             <field name="task_time"  groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            <field name="due_date"  groups="task_assignment.group_task_manager,task_assignment.group_task_supervisor"/>
            <field name="task_type"  groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            <field name="repeat_days_ids" widget="many2many_tags" options="{'no_create': True}"
                   invisible="task_type == 'daily' or task_type == 'monthly'"  groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            <field name="repeat_month_days" widget="many2many_tags" options="{'no_create': True}"
                   invisible="task_type != 'monthly'"  groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>
            <field name="repeat_until"  groups="task_assignment.group_task_manager ,task_assignment.group_task_supervisor"/>

                         </group>
                    </group>

                  <group string="Task Details" col="2">
                   <group>

                   <field name="image" widget="Binary" class="oe_avatar"
                          options="{'preview_image': 'image'}"/>
                       <field name ="comments"/>
                   </group>

                  </group>
                <group string="Manager Evaluation" groups="task_assignment.group_task_manager">
                  <field name="feedback_score"/>
                </group>
                    <group string="Manager Evaluation" groups="task_assignment.group_task_supervisor">

                   <field name="feedback_score" />
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_employee_task_tree" model="ir.ui.view">
        <field name="name">employee.task.tree</field>
        <field name="model">employee.task</field>
        <field name="arch" type="xml">
            <tree>

                <field name="status_display" readonly="1" widget="badge"  decoration-success="status_display == 'done'"
                                       decoration-danger="status_display == 'overdue'"
                                       decoration-warning="status_display == 'cancel'" />
                <field name="task_code" readonly="1"/>
                <field name="task_id"/>
                <field name="employee_id"/>
                  <field name="task_type"/>
                <field name="repeat_days_ids" widget="many2many_tags" options="{'no_create': True}"
       invisible="task_type == 'daily' or task_type == 'monthly'"/>
                <field name="repeat_month_days" widget="many2many_tags" options="{'no_create': True}"
       invisible="task_type != 'monthly'"/>
                <field name="task_time"/>
                <field name="due_date"/>
                <field name="feedback_score"  decoration-danger="feedback_score==0"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_task" model="ir.actions.act_window">
        <field name="name">Employee Tasks</field>
        <field name="res_model">employee.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_employee_task_today" model="ir.actions.act_window">
    <field name="name">Today's Tasks</field>
    <field name="res_model">employee.task</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('due_date', '=', context_today())]</field>
</record>


    <!-- Menus -->
    <menuitem id="menu_employee_task_root" name="Employee Task Manager" sequence="100"/>
        <menuitem id="menu_employee_task_user" name="Employee Task user" sequence="101"/>


    <menuitem id="menu_employee_task_main" name="Manage Tasks"
              parent="menu_employee_task_root"
              action="action_employee_task"
              sequence="10"
              groups="task_assignment.group_task_manager,task_assignment.group_task_supervisor"
    />

   <menuitem id="menu_employee_task_today"
          name="Today's Tasks"
          parent="menu_employee_task_user"
          action="action_employee_task_today"
          groups="task_assignment.group_task_user"/>




</odoo>
