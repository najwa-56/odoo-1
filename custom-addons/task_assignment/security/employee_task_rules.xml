<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_employee_task">
        <field name="name">Employee Task</field>
        <field name="description">Employee Task group</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_task_user" model="res.groups">
        <field name="name"> User</field>
        <field name="category_id" ref="module_employee_task" />

    </record>
     <record id="group_task_manager" model="res.groups">
        <field name="name"> Manager</field>
        <field name="category_id" ref="module_employee_task" />
    </record>

    <odoo>
    <record id="employee_task_rule_user_own_tasks" model="ir.rule">
        <field name="name">Employee Task - Only Own Tasks</field>
        <field name="model_id" ref="model_employee_task"/>
        <field name="domain_force">[('employee_id.user_id.id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('task_assignment.group_task_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>

</odoo>