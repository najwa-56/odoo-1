<odoo>
    <data>
        <template id="report_session_summary">
           <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o" t-key="o_key">
                    <div class="page">
                        <t t-set="product_wise_report" t-value="o.wk_session_sale_details()"/>
                        <h2>Session Summary: <span t-field="o.name"/></h2>

                        <table cellpadding="10" style="text-align:left" class="table table-condensed mb32">
                            <thead>
                                <tr>
                                    <th>
                                        <strong>Responsible</strong>
                                    </th>
                                    <th>
                                        <strong>Point of Sale</strong>
                                    </th>
                                    <th class="text-right">
                                        <strong>Opening Date</strong>
                                    </th>
                                    <th class="text-right">
                                        <strong>Closing Date</strong>
                                    </th>
                                    <th class="text-right">
                                        <strong>Total Sale</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.user_id"/></td>
                                    <td><span class="text-right" t-field="o.config_id"/></td>
                                    <td><span t-esc="product_wise_report.get('start_date')"/></td>
                                    <td><span t-esc="product_wise_report.get('stop_date')"/></td>
                                    <td><span t-esc="product_wise_report.get('total_sale') " t-options="{'widget': 'float', 'precision': currency_precision}"/></td>
                                </tr>
                            </tbody>
                        </table>

                            <h4>Statement Summary</h4>
                            <table cellpadding="10" style="text-align:left;" class="table table-condensed">
                                <thead>
                                    <tr style="border-bottom:2px solid red">
                                        <th>Journal</th>
                                        <th>Transaction Amount </th>
                                    </tr>
                                </thead>
                                <tbody>
                                <t t-foreach="o.wk_pos_statement_details()" t-as="details" t-key="detials_key">
                                    <tr>
                                        <td><span t-esc="details.get('name')"/></td>
                                        <td><span t-esc="details.get('amount') " t-options="{'widget': 'float', 'precision': currency_precision}" /></td>
                                    </tr>
                                </t>
                                </tbody>
                            </table>


                        <t t-foreach="o.wk_pos_payment_details()" t-as="details" t-key="detials_keys">
                            <h4 t-if='details'>Payment Summary: <span t-esc="details.get('name')"></span></h4>
                            <table cellpadding="10"  style="text-align:left;" class="table table-condensed" t-if="details.get('data')">
                                <thead>
                                    <tr style="border-bottom:2px solid red">
                                        <th>Date</th>
                                        <th>Payment_method </th>
                                        <th>Order</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="details.get('data')" t-as="line" t-key="line_key">
                                        <tr style="border-bottom:2px solid red">
                                            <td><span t-esc="line.get('payment_date').date()"/></td>
                                            <td><span t-esc="line.get('payment_method_id')[1]"/></td>
                                            <td><span t-esc="line.get('pos_order_id')[1]"/></td>
                                            <td >
                                                <span t-esc="line.get('amount')" t-options="{'widget': 'float', 'precision': currency_precision}"
                                                    />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="product_wise_report.get('order_details')">
                            <h4>Point Of Sale Order Details</h4>

                            <table cellpadding="10"  style="text-align:left;" class="table table-condensed">
                                <thead>
                                    <tr>
                                        <th>Order Date</th>
                                        <th>Order Reference</th>
                                        <th>Customer</th>
                                        <th>Picking Name</th>
                                        <th >Total Tax</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="product_wise_report.get('order_details')" t-as='order' t-key="order_key">
                                        <td><t t-esc="order.get('date')" /></td>
                                        <td><t t-esc="order.get('name')" /></td>
                                        <td><t t-esc="order.get('partner')" /></td>
                                        <td><t t-esc="order.get('picking')" /></td>
                                        <td >
                                            <span t-esc="order.get('total_tax')" t-options="{'widget': 'float', 'precision': currency_precision}"
                                              />
                                        </td>
                                        <td >
                                            <span t-esc="order.get('total_amount')"  t-options="{'widget': 'float', 'precision': currency_precision}"
                                               />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="product_wise_report.get('products')">
                            <h4>Product Summary</h4>
                            <table cellpadding="10" style="text-align:left;" class="table table-condensed">
                                <thead><tr>
                                    <th>Product</th>
                                    <th>Quantity Sold</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="product_wise_report['products']" t-as='line' t-key="line_key">
                                        <td><t t-esc="line['product_name']" /></td>
                                        <td>
                                            <t t-esc="line['quantity']" />
                                            <t t-esc='line["uom"]' /> 
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
