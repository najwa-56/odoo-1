<odoo>
	<record id="view_pos_config_res_setting_form_inherit" model="ir.ui.view">
		<field name="name">>POS Session Print Configuration</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="Session Summary">
                    <setting string="Print Session Summary." help="Print Session Summary in running Session.">
                        <field name="pos_wk_print_session_summary"/>
                    </setting>
                </block>
			</xpath>
		</field>
	</record>
</odoo>