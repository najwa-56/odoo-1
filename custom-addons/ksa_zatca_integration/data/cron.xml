<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_account_move_send_multiple_to_zatca" model="ir.cron">
            <field name="name">Send Multiple invoices To Zatca</field>
            <field name="model_id" ref="model_account_move" />
            <field name="state">code</field>
            <field name="code">model.send_cron_multiple_to_zatca()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>



        <record id="ir_cron_send_inovoice_job_count" model="ir.cron">
    <field name="name">Batch Old Invoice Send To Zatca</field>
    <field name="model_id" ref="model_account_move" />
    <field name="state">code</field>
    <field name="code">model.send_invoice_batch()</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
</record>


  <record id="ir_cron_resend_inovoice_job_count" model="ir.cron">
    <field name="name">Invoice ReSend To Zatca</field>
    <field name="model_id" ref="model_account_move" />
    <field name="state">code</field>
    <field name="code">model.resend_invoice()</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
</record>









    </data>
</odoo>