<odoo>
  <!-- تشغيل يدوي من زر الإجراءات في شاشة مخصصات الإجازة -->
  <record id="action_carry_emergency_balance_now" model="ir.actions.server">
    <field name="name">Carry Emergency Balance Now</field>
    <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
    <field name="state">code</field>
    <!-- نستخدم model لأن model_id = hr.leave.allocation -->
    <field name="code">
      env['hr.leave.carryover.wizard'].cron_carryover_emergency_to_annual()
    </field>
      <field name="binding_model_id" ref="hr_holidays.model_hr_leave_allocation"/>
    <field name="binding_type">action</field>
  </record>

  <!-- جدولة يومية تلقائية -->
  <record id="ir_cron_carry_emergency_balance" model="ir.cron">
    <field name="name">Carry Emergency → Annual</field>
    <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
    <field name="state">code</field>
     <field name="code">
      env['hr.leave.carryover.wizard'].cron_carryover_emergency_to_annual()
    </field>
    <field name="interval_type">days</field>
    <field name="interval_number">1</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
    <!-- شغّليه بحساب المسؤول أو مستخدم سيستم مناسب -->
    <field name="user_id" ref="base.user_root"/>
    <!-- اختياري: utc (عدليه حسب وقتك) -->
    <!-- <field name="nextcall">2025-09-06 20:55:00</field> -->
  </record>
</odoo>
