<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_purchase_order_line_discount_form" model="ir.ui.view">
            <field name="name">purchase.order.line.discount.form.view</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">

                <xpath expr="//tree/field[@name='discount']" position="after">
                    <field name="fixed_discount" optional="hide" />
                    <field name="amount_before_discount" optional="hide" />

                </xpath>
            </field>
        </record>


          <record id="view_purchase_account_move_line_discount_form" model="ir.ui.view">
            <field name="name">account.move.line.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

              

                <xpath expr="//field[@name='line_ids']/tree/field[@name='tax_tag_ids']" position="after">
                    <field name="fixed_discount" optional="hide" />
                    <field name="amount_before_discount" optional="hide" />

                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="after">
                    <field name="fixed_discount" optional="hide" />
                    <field name="amount_before_discount" optional="hide" />

                </xpath>

            </field>
        </record>


    </data>
</odoo>