<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_purchase_order_invoice_discount_form" model="ir.ui.view">
            <field name="name">purchase.order.invoice.discount.form.view</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='date_approve']" position="after">
                    <field name="discount_type" widget="radio" readonly="state == 'purchase'" />
                </xpath>


                <field name="notes" position="after">
                                            
                    <field name="discount_method" class="oe_inline"  readonly="state == 'purchase'" invisible="discount_type == 'line'"/>
                    <label for="discount_amount" invisible="discount_type == 'line'"/>
                    <div>
                        <field name="discount_amount" class="oe_inline" readonly="state == 'purchase'" invisible="discount_type == 'line'"/>
                        <label for="discount_amount" string="%%" invisible="discount_method == 'fix' or discount_type == 'line' "/>
                    </div>
                    <field name="config_tax" widget="monetary" invisible="1"/>
                    <field name="report_total" invisible="1"/>
                    <!-- <field name="untax_test_amount" invisible="1"/> -->
                    <!-- <field name="line_total_amount" invisible="1"/> -->
                </field>

                <xpath expr="//tree/field[@name='discount']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//tree/field[@name='name']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//tree/field[@name='price_subtotal']" position="before">
                 <field name="fixed_discount" optional="hide"/> 
                    <field name="amount_before_discount" optional="hide"/>
                </xpath>


                
                
                <field name="tax_totals" position="before">
                     <field name="discount_amt" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="discount_type == 'line'"/>
                     <field name="discount_amt_line" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="discount_type == 'global'"/>
                </field>

                <xpath expr="//tree/field[@name='product_qty']" position="before">
                    <field name="discount_type" column_invisible="1"/>
                    <field name="discount_method" column_invisible="parent.discount_type == 'global'"/>
                    <field name="discount_amount" column_invisible="parent.discount_type == 'global'"/>
                    <field name="discount_amt" column_invisible="1"/>
                </xpath>
            </field>
        </record>
        
        <record id="view_purchase_account_move_discount_form" model="ir.ui.view">
            <field name="name">account.move.discount.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <field name="narration" position="after">
                <field name="discount_type" column_invisible="1"/>
                    <group style="width: 65%%" invisible="move_type in ('out_invoice', 'out_refund','out_receipt')">
                        <label for="discount_method" invisible="discount_type == 'line'"/>
                        <div>
                            <field name="discount_method" class="oe_inline" invisible="discount_type == 'line'" readonly="state == 'posted'"/>
                        </div>
                         <label for="discount_amount" invisible="discount_type == 'line'"/>
                        <div>
                            <field name="discount_amount" class="oe_inline" invisible="discount_type == 'line'" readonly="state == 'posted'"/>
                            <label for="discount_amount" string="%%"
                                 class="oe_inline" invisible="discount_method != 'per' or discount_type != 'global'"/>
                        </div>
                    </group>
                    <field name="config_inv_tax" invisible="1"/>
                    <field name="final_count_total" invisible="1"/>
                    <!-- <field name="untax_test_amount" invisible="1"/> -->
                </field>

                <xpath expr="//field[@name='tax_totals']" position="before">
                    <field name="discount_amt" widget="monetary" options="{'currency_field': 'currency_id'}"   invisible="move_type  in ('out_invoice', 'out_refund','out_receipt') or discount_type == 'line'"/>
                    <field name="discount_amt_line" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="move_type  in ('out_invoice', 'out_refund','out_receipt') or discount_type == 'global'"/>
                </xpath>

                <xpath expr="//tree/field[@name='discount']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>


                <xpath expr="//field[@name='line_ids']/tree/field[@name='tax_tag_ids']" position="after">
                    <field name="discount_type" column_invisible="1"/>
                    <field name="discount_method" column_invisible="1"/>
                    <field name="discount_amount" column_invisible="1"/>
                    <field name="discount_amt" column_invisible="1"/>
                    <!-- <field name="fixed_discount" column_invisible="1"/> 
                    <field name="amount_before_discount" column_invisible="1"/> -->
                </xpath>

                  <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="before">
                 <field name="fixed_discount" optional="hide"/> 
                    <field name="amount_before_discount" optional="hide"/>
                </xpath>

            </field>
        </record>

        <record id="view_move_form_inherits" model="ir.ui.view">
            <field name="name">account.move.line.form.followup</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='partner_id']" position="after">
                    <field name="is_global_disc" column_invisible="1"/>
                </xpath>                
                
            </field>
        </record>




        <record id="view_account_account_discount_form" model="ir.ui.view">
            <field name="name">account.account.discount.form.view</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form" />
            <field name="arch" type="xml">
                <field name="account_type" position="after">
                    <field name="discount_account" />
                </field>
            </field>
        </record>


        <record id="res_config_settings_view_form_discount" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.discount</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="10"/>
            <field name="inherit_id" ref="sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='quotation_order_setting_container']" position="before">  
                    <h2>Discount Setting</h2>
                    <div class="row mt16 o_settings_container" id="global_commission_settings">  
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="tax_discount_policy"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="tax_discount_policy" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="purchase_account_id"/>
                                    <div class="mt16">
                                        <field name="purchase_account_id" class="o_light_label"/>
                                    </div>
                                </div>
                                <div class="content-group">
                                    <label for="sale_account_id"/>
                                    <div class="mt16">
                                        <field name="sale_account_id" class="o_light_label" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
