<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_gpr_integration" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.gpr</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="gpr_api_key" invisible="use_payment_terminal != 'gpr'" required="use_payment_terminal == 'gpr'"/>
                <field name="gpr_terminal_identifier" invisible="use_payment_terminal != 'gpr'" required="use_payment_terminal == 'gpr'"/>
        </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form_inherit_pos_gpr_integration" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.gpr</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='session_id']" position="after">
                <field name="gpr_data" invisible="1"/>
                <field name="TransactionResponseEnglish" invisible="gpr_data == False" />
                <field name="PrimaryAccountNumber" invisible="gpr_data == False"/>
                <field name="TransactionAuthCode" invisible="gpr_data == False"/>
                <field name="CardScheme" invisible="gpr_data == False"/>
                <field name="CardAcceptorTerminalId" invisible="gpr_data == False"/>
                <field name="RetrievalReferenceNumber" invisible="gpr_data == False"/>
                <field name="CardAcceptorIdCode" invisible="gpr_data == False"/>
           </xpath>
        </field>
    </record>
</odoo>
