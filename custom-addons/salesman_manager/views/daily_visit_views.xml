<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- هذا xml الخاص بصفحة الزيارات -->
        <!-- Tree View for Daily Visits -->
        <record id="view_daily_visit_tree" model="ir.ui.view">
            <field name="name">daily.visit.tree</field>
            <field name="model">daily.visit</field>
            <field name="arch" type="xml">
                <tree string="الزيارات">
                    <field name="reference"/>
                    <field name="created_by"/>
                    <field name="creation_date" optional="hide"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    <field name="partner_id"/>
                    <field name="decision_state" widget="badge"
                           decoration-danger="decision_state == 'reject'"
                           decoration-success="decision_state == 'accept'"/>
                </tree>
            </field>
        </record>


        <!-- Form View for Daily Visits -->
        <record id="view_daily_visit_form" model="ir.ui.view">
            <field name="name">daily.visit.form</field>
            <field name="model">daily.visit</field>
            <field name="arch" type="xml">
                <form string="الزيارات">
                    <sheet>
                        <!--  Smart Buttons Area -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_adjustmen"
                                    type="object"
                                    string="Partner Adjustment"
                                    class="oe_stat_button"
                                    icon="fa-calculator"/>
                            <button name="action_view_related_sale_orders"
                                    type="object"
                                    string="Sale orders"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o"/>
                        </div>

                        <!-- Reference in Header -->
                        <div class="oe_title">
                            <h1>
                                <field name="reference" readonly="1"/>
                            </h1>
                        </div>

                        <!-- Main Info -->
                        <group>
                            <field name="reference" invisible="1"/>
                            <field name="created_by"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="is_it_sold" invisible="1"/>
                            <field name="decision_state" invisible="1"/>
                            <group invisible="not is_later">
                                <field name="is_later" invisible="1"/>
                                <button name="action_open_partner_adjustment"
                                        type="object"
                                        string="الجرد"
                                        class="btn btn-primary"/>
                            </group>
                            <field name="weekly_route_id" invisible="1"/>
                            <field name="ref"/>
                            <group>
                                <button name="action_accept_sale"
                                        string="قبول"
                                        type="object"
                                        class="btn btn-success"/>
                                <button name="action_reject_sale"
                                        string="رفض"
                                        type="object"
                                        class="btn btn-danger"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- don't show this page until user click on action_accept_sale or action_reject_sale button -->
                            <page string="تفاصيل" style="text-align: right;" invisible="decision_state == False">


                                <!-- Not Sold Section -->
                                <group invisible="is_it_sold" col="1">
                                    <div class="text-muted o_form_label">في حال عدم البيع، اذكر السبب مع إرفاق صورة
                                    </div>
                                    <separator string="" colspan="1"/>
                                    <field name="attachment_ifNotSold"
                                           string="ارفق الصورة"
                                           widget="binary"
                                           class="oe_inline"/>
                                    <field name="reason_ifNotSold"
                                           string="السبب"
                                           placeholder="اذكر السبب..."
                                           widget="text"
                                           class="o_form_textarea"/>

                                    <div class="o_form_label">Check out</div>
                                    <div>
                                        <button name="action_check_out"
                                                type="object"
                                                string="---Check out---"
                                                class="btn btn-primary"
                                        />
                                    </div>
                                    <separator string="" colspan="1"/>
                                    <field name="check_out_time" nolabel="1"
                                           groups="salesman_manager.group_salesman_supervisor"/>
                                </group>

                                <!-- Sold Section -->
                                <group invisible="not is_it_sold" col="2">
                                    <div class="text-muted o_form_label" style="padding-bottom: 10px;">في حال البيع
                                    </div>
                                    <div class="o_form_label"></div>
                                    <field name="today_date" invisible="1"/>
                                    <field name="attachment_before" widget="binary" class="oe_inline"/>
                                    <div class="o_form_label">sale</div>
                                    <div>
                                        <button name="action_create_sale_order"
                                                type="object"
                                                string="------- بيع ------"
                                                class="btn btn-primary"/>
                                    </div>
                                    <field name="attachment_after" widget="binary" class="oe_inline"/>

                                    <div class="o_form_label">Check out</div>
                                    <div>
                                        <button name="action_check_out"
                                                type="object"
                                                string="---Check out---"
                                                class="btn btn-primary"/>
                                    </div>
                                    <field name="check_out_time" nolabel="1"
                                           groups="salesman_manager.group_salesman_supervisor"/>
                                </group>


                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Search View for Daily Visits -->
        <record id="view_daily_visit_search" model="ir.ui.view">
            <field name="name">daily.visit.search</field>
            <field name="model">daily.visit</field>
            <field name="arch" type="xml">
                <search string="الزيارات">
                    <field name="reference"/>
                    <field name="partner_id"/>
                    <field name="created_by"/>
                </search>
            </field>
        </record>

        <!-- Action for supervisor: open tree view for daily visit-->
        <record id="action_daily_visit" model="ir.actions.act_window">
            <field name="name">الزيارات</field>
            <field name="res_model">daily.visit</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    قم بإنشاء أول زيارة
                </p>
            </field>
        </record>

        <!-- Action for Salesman: opens form view -->
        <record id="action_daily_visit_form_only" model="ir.actions.act_window">
            <field name="name">تسجيل زيارة</field>
            <field name="res_model">daily.visit</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'form_view_initial_mode': 'edit'}</field>
        </record>

        <!-- Menu for Daily Visits - only for supervisors -->
        <menuitem id="menu_daily_visit"
                  name="الزيارات"
                  parent="menu_sales_man_root"
                  action="action_daily_visit"
                  sequence="30"
                  groups="salesman_manager.group_salesman_supervisor"/>
    </data>
</odoo>
