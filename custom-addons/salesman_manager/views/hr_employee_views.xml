<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the employee form view to add the salesman_supervisor field -->
        <record id="view_employee_form_inherit_sales_man" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.sales.man</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="salesman_supervisor"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>