<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- هذا xml الخاص بصفحة مساراتي -->
        <!-- Tree View for My Routes -->
        <record id="view_my_routes_tree" model="ir.ui.view">
            <field name="name">my.routes.tree</field>
            <field name="model">weekly.routs</field>
            <field name="arch" type="xml">
                <tree string="مساراتي اليوم">
                    <field name="reference"/>
                    <field name="creation_date"/>
                    <field name="user_id" />
                </tree>
            </field>
        </record>

        <!-- Form View for My Routes-->
        <record id="view_my_routes_form" model="ir.ui.view">
            <field name="name">my.routes.form</field>
            <field name="model">weekly.routs</field>
            <field name="arch" type="xml">
                <form string="مساراتي اليوم" create="false" edit="false" delete="false" >
                    <sheet>
                        <group>
                            <group>
                                <field name="reference" readonly="1"/>
                                <field name="creation_date" readonly="1" groups="salesman_manager.group_salesman_supervisor"/>
                                <field name="user_id" readonly="1" groups="salesman_manager.group_salesman_supervisor"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="مساراتي اليوم" >
                                <field name="today_route_lines"> <!-- we create this field with computed method to filter the content based on today -->
                                    <tree>
                                        <field name="day"  groups="salesman_manager.group_salesman_supervisor"/>
                                        <field name="day_name"  groups="salesman_manager.group_salesman_supervisor"/>
                                        <field name="delivery_route_id" groups="salesman_manager.group_salesman_supervisor"/>
                                        <field name="weekly_route_id" invisible="1" />
                                        <field name="delivery_line_ids" context="{'default_weekly_route_id': weekly_route_id}" widget="many2many_tags"/>
                                    </tree>
                                    <form> <!-- once salesman click on delivery_line_ids (المسار) it should be open a form that have only delivery_line_ids -->
                                        <field name="weekly_route_id" invisible="1" />
                                         <field name="delivery_line_ids" context="{'default_weekly_route_id': weekly_route_id}"/>
                                         
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for My Routes -->
        <record id="view_my_routes_search" model="ir.ui.view">
            <field name="name">my.routes.search</field>
            <field name="model">weekly.routs</field>
            <field name="arch" type="xml">
                <search string="مساراتي اليوم">
                    <field name="reference"/>
                    <field name="creation_date"/>
                    <!--<field name="employee"/>-->
                    <field name="user_id" />
                    <filter string="مساراتي اليوم" name="today_routes"/>
                </search>
            </field>
        </record>

        <!-- Action for My Routes -->
        <record id="action_my_routes" model="ir.actions.act_window">
            <field name="name">مساراتي</field>
            <field name="res_model">weekly.routs</field>
            <field name="view_mode">tree,form</field>
            <!-- ('Starting_date', '&lt;=', context_today()), ('Ending_date', '>=', context_today()) it is used to let the supervisor to determin period of time that the record shown for the salesman -->
            <!-- ('user_id', '=', uid) used to show the current user login record-->
             <field name="domain">[('user_id', '=', uid),('Starting_date', '&lt;=', context_today()), ('Ending_date', '>=', context_today())]</field>
             <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    لا توجد مسارات مخصصة لك اليوم
                </p>
            </field>
            <field name="view_ids" eval="[(5, 0, 0),
                                          (0, 0, {'view_mode': 'tree', 'view_id': ref('view_my_routes_tree')}),
                                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_my_routes_form')})]"/>

        </record>

        <!-- Menu for My Routes - only accessible to salespeople groups="salesman_manager.group_salesman"-->
        <menuitem id="menu_my_routes"
                  name="مساراتي"
                  action="action_my_routes"
                  sequence="1"
                  groups="salesman_manager.group_salesman"
                  />
    </data>
</odoo>