        <record id="delivery_route_lines_form_inherited" model="ir.ui.view">
            <field name="name">Route Inherited</field>
            <field name="model">route.line</field>
            <field name="inherit_id" ref="customer_route_management.route_lines_view_form"/>
            <field name="arch" type="xml">
                <data>
                    <!-- <xpath expr="//field[@name='route']" position="after">
                        <group>
                            <button name="%(action_partner_map_view)d"
                                    type="action"
                                    string="map"
                                    class="btn-primary"
                            />
                        </group>
                    </xpath> -->
                    <xpath expr="//field[@name='cust_tree_ids']" position="replace">
                        <field name="cust_tree_ids" invisible="delivery_route_link_id == False">
                            <tree create="True">

                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <button name="open_map"
                                        string="map"
                                        class="btn-primary"
                                        style="border-radius: 50%; padding: 10px;"
                                        type="object"
                                        />
                                <button name="action_open_daily_visit"
                                        string="تسجيل زيارة"
                                        class="btn-primary"
                                        style="background-color: red; border-radius: 50%; padding: 10px;"
                                        type="object"
                                        groups="salesman_manager.group_salesman"/>
                                <field name="status"
                                       decoration-success="status == 'sale'"
                                       decoration-danger="status == 'visit'"
                                       decoration-warning="status == 'not_yet'"
                                       widget="badge"
                                />
                                <field name="specific_visit_id"/>
                                <button name="action_open_specific_visit"
                                        type="object"
                                        string="Open Visit"
                                        icon="fa-external-link"
                                        attrs="{'invisible': [('specific_visit_id', '=', False)]}"
                                        groups="salesman_manager.group_salesman_supervisor"/>
                            </tree>
                        </field>
                    </xpath>

                    <xpath expr="//form" position="inside">
                        <group>
                            <div class="oe_chatter">
                                <field name="message_follower_ids" groups="base.group_user"/>
                                <field name="activity_ids"/>
                                <field name="message_ids"/>
                            </div>
                        </group>
                    </xpath>
                </data>
            </field>
        </record>


        <!-- to bring customer_route_management to salesman_manager app -->
        <menuitem id="menu_routs"
                  name="المسارات"
                  parent="menu_sales_man_root"
                  action="customer_route_management.delivery_route_action"
                  sequence="19"/>

    </data>
</odoo>