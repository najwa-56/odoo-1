<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_visit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.visit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="action_back_to_visit"
                            type="object"
                            string="Back to Visit"
                            class="btn-secondary"
                            icon="fa-arrow-left"/>
                </xpath>

                 <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="visit_id" groups="salesman_manager.group_salesman_supervisor"/>
                    <field name="visit_reference" readonly="1" groups="salesman_manager.group_salesman_supervisor"/>
                </xpath>

            </field>
        </record>


    </data>
</odoo>