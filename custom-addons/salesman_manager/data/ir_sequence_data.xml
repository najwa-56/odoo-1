<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Weekly Routes -->
        <record id="seq_weekly_routes" model="ir.sequence">
            <field name="name">Weekly Routes Sequence</field>
            <field name="code">weekly.routs</field>
            <field name="prefix">WR/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Daily Visits -->
        <record id="seq_daily_visit" model="ir.sequence">
            <field name="name">Daily Visit Sequence</field>
            <field name="code">daily.visit</field>
            <field name="prefix">الزيارة/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>