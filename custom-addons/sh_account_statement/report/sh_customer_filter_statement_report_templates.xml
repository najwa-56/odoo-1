    <!--edit this template to show zero values , order asc by sh_filter_invoice_date ,  -->
    <template id="sh_customer_filtered_statement_doc">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context(lang=o.lang)" />
        <div class="page">
            <div class="oe_structure" />
            <div>
                Date From -  <span t-field="o.start_date" /><br />
                Date To -    <span t-field="o.end_date" /><br />
                Printed By - <span t-field="user.name" /><br />
            </div>
            <center>
                <span style="font-weight: 800; font-size: 25px;">
                 اسم العميل <t t-esc="o.name"/>
                </span>
            </center>

            <t t-if="o.sh_filter_customer_statement_ids">
                <table class="table table-sm o_main_table mt-2">
                    <thead style="display: table-row-group;">
                        <tr>
                            <th>Number</th>
                            <th>Account</th>
                            <th>Date</th>
                            <th>Due Date</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="amount" t-value="0.0" />
                        <t t-set="paid_amount" t-value="0.0" />
                        <t t-foreach="o.sh_filter_customer_statement_ids.sorted(key=lambda l: l.sh_filter_invoice_date or '1970-01-01')" t-as="line">
                            <t t-set="amount" t-value="amount + line.sh_filter_amount" />
                            <t t-set="paid_amount" t-value="paid_amount + line.sh_filter_paid_amount" />

                            <tr>
                                <td><span t-field="line.name" /></td>
                                <td><span t-field="line.sh_account" /></td>
                                <td><span t-field="line.sh_filter_invoice_date" /></td>
                                <td><span t-field="line.sh_filter_due_date" /></td>
                                <td><span t-esc="'%.2f' % line.sh_filter_amount" /></td>
                                <td><span t-esc="'%.2f' % line.sh_filter_paid_amount" /></td>
                                <td><span t-esc="'%.2f' % line.sh_filter_running_balance" /></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <!-- Add this after the closing balance div -->
            <div style="margin-top: 30px; text-align: center; font-size: 14px;">
               <p>
                  تعتبر الحسابات صحيحة الا ماكان فيه اعتراض خلال 10 أيام من تاريخ كشف الحساب
               </p>
            </div>

        </div>
    </t>
</template>


    <template id="sh_customer_filtered_statement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sh_account_statement.sh_customer_filtered_statement_doc" t-lang="o.lang" />
            </t>
        </t>
    </template>
    <record id="action_report_sh_customer_filtered_statement" model="ir.actions.report">
        <field name="name">Customer Statement Filter By Date</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'Customer Statement Filter By Date'</field>
        <field name="report_name">sh_account_statement.sh_customer_filtered_statement_template</field>
        <field name="report_file">sh_account_statement.sh_customer_filtered_statement_template</field>
        <field name="binding_model_id" ref="model_res_partner" />
        <field name="binding_type">report</field>
    </record>
</odoo>
