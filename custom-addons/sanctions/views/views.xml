<odoo>

  <data>
  <record id="sanctions_sequence" model="ir.sequence">
       <field name="name">Sanctions</field>
       <field name="code">sanctions.sanctions</field>
       <field name="prefix">HP</field>
       <field name="padding">5</field>
       <field name="company_id" eval="False"/>
   </record>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="sanctions.list">
      <field name="name">sanctions list</field>
      <field name="model">sanctions.sanctions</field>
      <field name="arch" type="xml">
        <tree>
          <field name="reference_no" readonly ="1"/>
          <field name="name"/>
          <!-- <field name="value2"/> -->
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="sanctions.form">
        <field name="name">sanctions form</field>
        <field name="model">sanctions.sanctions</field>
        <field name="arch" type="xml">
          <form>
          <sheet>
            <group>
            <field name="name"/>
            <!-- <field name="jobs" widget="many2many_tags"/> -->
            </group>
                <notebook>
                  <page string="القواعد">
                    <group>
                        <field name="rols">
                          <tree string="Role" editable="top">
                            <field name="num"/>
                            <field name="times"/>
                            <field name="type"/>
                            <field name="amount"/>
                            <field name="salary" />
                          </tree>
                        </field>
                    </group>
                  </page>
                </notebook>
          </sheet>
          </form>
        </field>
  </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="sanctions.action_window">
      <field name="name">قائمة العقوبات</field>
      <field name="res_model">sanctions.sanctions</field>
      <field name="view_mode">tree,form</field>
    </record>


    <!-- server action to the one above -->

    <record model="ir.actions.server" id="sanctions.action_server">
      <field name="name">sanctions server</field>
      <field name="model_id" ref="model_sanctions_sanctions"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>



                  
    <menuitem name="العقوبات" id="menu_root"
    web_icon="sanctions,static/src/img/san.png" groups="sanctions.sanction_main_menu" sequence="10"
    />

    <!-- menu categories -->
<!-- 
    <menuitem name="Menu 1" id="sanctions.menu_1" parent="sanctions.menu_root"/>
    <menuitem name="Menu 2" id="sanctions.menu_2" parent="sanctions.menu_root"/> -->

    <!-- actions -->

    <menuitem name="قائمة العقوبات" id="sanctions.menu_1_list" parent="sanctions.menu_root"
              action="sanctions.action_window" sequence="2"/>
    <!-- <menuitem name="Server to list" id="sanctions" parent="sanctions.menu_root"
              action="sanctions.action_server"/> -->
  </data>
</odoo>