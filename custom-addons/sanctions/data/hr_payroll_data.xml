            <!-- <field name="struct_id" ref="om_hr_payroll.structure_001"/> -->
        </record>
        
        <record id="hr_salary_rule_employee_sanctions_percentage_of_day" model="hr.salary.rule">
            <field name="name">Employee Sanction in Fixed Amount</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
