<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data noupdate="1">

	
	    <record id="hr_salary_rule_employee_sanctions_hours" model="hr.salary.rule">
            <field name="name">Employee Sanction in hours</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="code">SANCTION_AMOUNT_H</field>
            <field name="sequence" eval="203"/>
            <field name="condition_select">none</field>
            <!-- <field name="condition_python">True</field> -->
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
sanc = contract.employee_id.sanction.filtered(lambda s:s.stype == 'hours') 
r = 0
for s in sanc:
        if s and s.dateof.month == payslip.date_to.month  and s.expt == 0 and s.state == 'confirm':
            r+=-(contract.wage/(30*8))*float(s.samount)
result =r
            </field>
            <!-- <field name="struct_id" ref="om_hr_payroll.structure_001"/> -->
        </record>

        <record id="hr_salary_rule_employee_sanctions_days" model="hr.salary.rule">
